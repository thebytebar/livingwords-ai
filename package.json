{
  "name": "livingwords-llm",
  "version": "0.1.0",
  "description": "Open-source God-centered LLM aligned with Christian theological doctrine. Small decoder-only transformer (theoSmall config) for Scripture paraphrase, devotional writing, and verse explanation. Training: Python + PyTorch. Inference: TypeScript with ONNX Runtime (onnxruntime-node, optional).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "lw": "dist/cli/index.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "postbuild": "chmod +x dist/cli/index.js",
    "start": "node dist/cli/index.js",
    "generate": "tsx src/cli/generate.ts",
    "chat": "tsx src/cli/chat.ts",
    "serve": "tsx src/cli/serve.ts",
    "dev": "tsx src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "npm run build && chmod +x dist/cli/index.js",
    "clean:weights": "rm -rf weights/latest training/checkpoints || true",
    "train:full": "npm run clean:weights && bash training/run_full_pipeline.sh"
  },
  "keywords": [
    "llm",
    "transformer",
    "gpt",
    "pytorch",
    "onnx",
    "bible",
    "christian",
    "faith-tech",
    "theology"
  ],
  "author": "The Byte Bar Co. <dev@thebytebar.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thebytebar/livingwords-llm.git"
  },
  "engines": {
    "node": ">=18 <23"
  },
  "files": [
    "dist",
    "weights"
  ],
  "type": "module",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.9.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "express": "^5.2.1",
    "fs-extra": "^11.3.5",
    "tiktoken": "^1.0.22",
    "onnxruntime-node": "^1.20.1"
  }
}