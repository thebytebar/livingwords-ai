{
  "name": "livingwords-llm",
  "version": "0.1.0",
  "description": "Local-first, source-grounded RAG using pretrained Gemma 4 E2B and an Apple Silicon-friendly MLX runtime.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "lw": "dist/cli/index.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/cli/index.js",
    "generate": "tsx src/cli/index.ts generate",
    "chat": "tsx src/cli/index.ts chat",
    "serve": "tsx src/cli/index.ts serve",
    "dev": "tsx src/index.ts",
    "test": "tsx --test src/core/rag.test.ts src/core/model-server.test.ts src/cli/serve.test.ts",
    "postinstall": "node scripts/install-local-model.mjs",
    "prepare": "npm run build"
  },
  "keywords": [
    "llm",
    "transformer",
    "gpt",
    "gemma",
    "mlx",
    "rag",
    "bible",
    "christian",
    "faith-tech",
    "theology"
  ],
  "author": "The Byte Bar Co. <dev@thebytebar.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thebytebar/livingwords-llm.git"
  },
  "engines": {
    "node": ">=18 <23"
  },
  "files": ["dist", "scripts/install-local-model.mjs"],
  "type": "module",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "express": "^5.2.1"
  }
}