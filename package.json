{
  "name": "livingwords-llm",
  "version": "0.1.0",
  "description": "Open-source God-centered LLM aligned with Christian theological doctrine. Small ~500k parameter decoder-only transformer designed to run on standard laptops using TensorFlow.js (CPU-only). Includes CLI, server/API, web UI, and training pipeline. Primary strength: Scripture paraphrase, devotional writing, and verse explanation.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "lw-llm": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/cli/index.js",
    "start": "node dist/cli/index.js",
    "train": "tsx src/cli/train.ts",
    "generate": "tsx src/cli/generate.ts",
    "chat": "tsx src/cli/chat.ts",
    "serve": "tsx src/cli/serve.ts",
    "dev": "tsx src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "npm run build && chmod +x dist/cli/index.js"
  },
  "keywords": [
    "llm",
    "transformer",
    "gpt",
    "tensorflowjs",
    "bible",
    "christian",
    "faith-tech",
    "theology"
  ],
  "author": "The Byte Bar Co. <dev@thebytebar.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thebytebar/livingwords-llm.git"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.21.0",
    "commander": "^12.1.0",
    "express": "^5.2.1",
    "fs-extra": "^11.2.0",
    "tiktoken": "^1.0.13"
  },
  "optionalDependencies": {
    "@tensorflow/tfjs-node": "^4.21.0"
  },
  "engines": {
    "node": ">=18 <23"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5.5.4"
  },
  "files": [
    "dist"
  ],
  "type": "module"
}
